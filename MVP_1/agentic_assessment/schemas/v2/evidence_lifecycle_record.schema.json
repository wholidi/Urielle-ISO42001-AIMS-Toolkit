{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/evidence_lifecycle_record.schema.json","title":"Evidence lifecycle record v2","type":"object","additionalProperties":false,
  "required":["schema_version","lifecycle_id","assessment_id","evidence_id","state","recorded_at","recorded_by","actor_type"],
  "properties":{"schema_version":{"const":"2.0.0"},"lifecycle_id":{"type":"string","pattern":"^LCR-[A-Z0-9][A-Z0-9._-]{2,95}$"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"evidence_id":{"type":"string","pattern":"^EVD-[A-Z0-9][A-Z0-9._-]{2,95}$"},"state":{"enum":["REFERENCED","FILE_PRESENT","INTEGRITY_VERIFIED","CONTENT_REVIEWED","ACCEPTED","REJECTED","UNABLE_TO_ESTABLISH"]},"recorded_at":{"type":"string","format":"date-time"},"recorded_by":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,99}$"},"actor_type":{"enum":["DETERMINISTIC_RULES","HUMAN"]},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"comments":{"type":"string","minLength":1,"maxLength":4000}},
  "allOf":[{"if":{"properties":{"actor_type":{"const":"DETERMINISTIC_RULES"}},"required":["actor_type"]},"then":{"properties":{"state":{"enum":["REFERENCED","FILE_PRESENT","INTEGRITY_VERIFIED","UNABLE_TO_ESTABLISH"]}}}},{"if":{"properties":{"state":{"enum":["CONTENT_REVIEWED","ACCEPTED","REJECTED"]}},"required":["state"]},"then":{"properties":{"actor_type":{"const":"HUMAN"}},"required":["comments"]}}]
}
