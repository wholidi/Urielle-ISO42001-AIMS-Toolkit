{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/assessment_plan.schema.json","title":"Clause-neutral assessment plan v2","type":"object","additionalProperties":false,
  "required":["schema_version","assessment_id","scope","requirement_refs","question_ids","plan_status","created_at","created_by"],
  "properties":{
    "schema_version":{"const":"2.0.0"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},
    "scope":{"type":"string","minLength":1,"maxLength":2000},"requirement_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)*(?:/[A-Z0-9._-]+)?$"}},
    "question_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^Q-[A-Z0-9][A-Z0-9._-]{2,95}$"}},
    "plan_status":{"enum":["DRAFT","APPROVED","CANCELLED"]},"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","pattern":"^[A-Z0-9][A-Z0-9._-]{2,99}$"}
  }
}
