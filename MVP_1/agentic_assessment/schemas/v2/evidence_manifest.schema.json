{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/evidence_manifest.schema.json","title":"Evidence manifest v2","type":"object","additionalProperties":false,
  "required":["schema_version","assessment_id","evidence_items"],"properties":{"schema_version":{"const":"2.0.0"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"evidence_items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}}},
  "$defs":{"safePath":{"type":"string","minLength":1,"maxLength":500,"pattern":"^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[\\\\])[^\\u0000]+$"},"item":{"type":"object","additionalProperties":false,"required":["evidence_id","path","media_type"],"properties":{"evidence_id":{"type":"string","pattern":"^EVD-[A-Z0-9][A-Z0-9._-]{2,95}$"},"path":{"$ref":"#/$defs/safePath"},"media_type":{"type":"string","pattern":"^[a-z0-9.+-]+/[a-z0-9.+-]+$"},"declared_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
}
