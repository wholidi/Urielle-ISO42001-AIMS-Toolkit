{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/evidence_acceptance_record.schema.json","title":"Question-specific human evidence acceptance v2","type":"object","additionalProperties":false,
  "required":["schema_version","acceptance_id","assessment_id","question_id","mapping_id","evidence_id","lifecycle_id","decision","decision_maker_type","reviewer_id","decided_at","rationale"],
  "properties":{"schema_version":{"const":"2.0.0"},"acceptance_id":{"type":"string","pattern":"^ACC-[A-Z0-9][A-Z0-9._-]{2,95}$"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"question_id":{"type":"string","pattern":"^Q-[A-Z0-9][A-Z0-9._-]{2,95}$"},"mapping_id":{"type":"string","pattern":"^MAP-[A-Z0-9][A-Z0-9._-]{2,95}$"},"evidence_id":{"type":"string","pattern":"^EVD-[A-Z0-9][A-Z0-9._-]{2,95}$"},"lifecycle_id":{"type":"string","pattern":"^LCR-[A-Z0-9][A-Z0-9._-]{2,95}$"},"decision":{"enum":["ACCEPTED","REJECTED"]},"decision_maker_type":{"const":"HUMAN"},"reviewer_id":{"type":"string","pattern":"^HUM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"decided_at":{"type":"string","format":"date-time"},"rationale":{"type":"string","minLength":1,"maxLength":4000}}
}
