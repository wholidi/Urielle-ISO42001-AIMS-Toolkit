{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/evidence_mapping.schema.json","title":"Question-specific evidence mapping v2","type":"object","additionalProperties":false,
  "required":["schema_version","mapping_id","assessment_id","question_id","requirement_ref","evidence_id","mapping_status","created_at"],
  "properties":{"schema_version":{"const":"2.0.0"},"mapping_id":{"type":"string","pattern":"^MAP-[A-Z0-9][A-Z0-9._-]{2,95}$"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"question_id":{"type":"string","pattern":"^Q-[A-Z0-9][A-Z0-9._-]{2,95}$"},"requirement_ref":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)*(?:/[A-Z0-9._-]+)?$"},"evidence_id":{"type":"string","pattern":"^EVD-[A-Z0-9][A-Z0-9._-]{2,95}$"},"mapping_status":{"enum":["PROPOSED","IN_SCOPE","OUT_OF_SCOPE"]},"created_at":{"type":"string","format":"date-time"}}
}
