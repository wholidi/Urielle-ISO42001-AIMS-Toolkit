{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/finding.schema.json","title":"Finding v2","type":"object","additionalProperties":false,
  "required":["schema_version","finding_id","assessment_id","requirement_assessment_id","question_id","status","disposition","condition","criteria","created_at"],
  "properties":{"schema_version":{"const":"2.0.0"},"finding_id":{"type":"string","pattern":"^FND-[A-Z0-9][A-Z0-9._-]{2,95}$"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"requirement_assessment_id":{"type":"string","pattern":"^REQ-[A-Z0-9][A-Z0-9._-]{2,95}$"},"question_id":{"type":"string","pattern":"^Q-[A-Z0-9][A-Z0-9._-]{2,95}$"},"status":{"enum":["DRAFT","RESOLVED"]},"disposition":{"enum":["PENDING","ACCEPTED","MODIFIED","REJECTED"]},"condition":{"type":"string","minLength":1,"maxLength":4000},"criteria":{"type":"string","minLength":1,"maxLength":4000},"created_at":{"type":"string","format":"date-time"},"reviewer_id":{"type":"string","pattern":"^HUM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"reviewed_at":{"type":"string","format":"date-time"},"review_comments":{"type":"string","minLength":1,"maxLength":4000}},
  "allOf":[{"if":{"properties":{"disposition":{"const":"PENDING"}},"required":["disposition"]},"then":{"properties":{"status":{"const":"DRAFT"}},"not":{"anyOf":[{"required":["reviewer_id"]},{"required":["reviewed_at"]},{"required":["review_comments"]}]}}},{"if":{"properties":{"disposition":{"enum":["ACCEPTED","MODIFIED","REJECTED"]}},"required":["disposition"]},"then":{"properties":{"status":{"const":"RESOLVED"}},"required":["reviewer_id","reviewed_at","review_comments"]}}]
}
