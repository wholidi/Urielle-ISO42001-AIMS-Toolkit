{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://urielle-ai.com/schemas/agentic_assessment/v2/requirement_assessment.schema.json","title":"Requirement assessment v2","type":"object","additionalProperties":false,
  "required":["schema_version","requirement_assessment_id","assessment_id","requirement_ref","question_id","outcome","accepted_evidence_acceptance_ids","rationale","evaluated_at","evaluator_type"],
  "properties":{"schema_version":{"const":"2.0.0"},"requirement_assessment_id":{"type":"string","pattern":"^REQ-[A-Z0-9][A-Z0-9._-]{2,95}$"},"assessment_id":{"type":"string","pattern":"^ASM-[A-Z0-9][A-Z0-9._-]{2,95}$"},"requirement_ref":{"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+)*(?:/[A-Z0-9._-]+)?$"},"question_id":{"type":"string","pattern":"^Q-[A-Z0-9][A-Z0-9._-]{2,95}$"},"outcome":{"enum":["SUPPORTED","UNSUPPORTED","UNRESOLVED","NOT_APPLICABLE"]},"accepted_evidence_acceptance_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^ACC-[A-Z0-9][A-Z0-9._-]{2,95}$"}},"rationale":{"type":"string","minLength":1,"maxLength":4000},"evaluated_at":{"type":"string","format":"date-time"},"evaluator_type":{"const":"DETERMINISTIC_RULES"}},
  "allOf":[{"if":{"properties":{"outcome":{"const":"SUPPORTED"}},"required":["outcome"]},"then":{"properties":{"accepted_evidence_acceptance_ids":{"minItems":1}}}},{"if":{"properties":{"outcome":{"enum":["UNSUPPORTED","UNRESOLVED","NOT_APPLICABLE"]}},"required":["outcome"]},"then":{"properties":{"accepted_evidence_acceptance_ids":{"maxItems":0}}}}]
}
