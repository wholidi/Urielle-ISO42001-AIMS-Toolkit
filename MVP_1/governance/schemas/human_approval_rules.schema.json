{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urielle-ai.com/schemas/governance/human_approval_rules.schema.json",
  "title": "Urielle-AI Human Approval Rules",
  "description": "Fail-closed rules defining actions that require explicit human approval. Automated components cannot self-approve or bypass required review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules_version",
    "default_decision",
    "self_approval_prohibited",
    "approval_bypass_prohibited",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "rules_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "default_decision": {
      "type": "string",
      "const": "REQUIRE_HUMAN_APPROVAL"
    },
    "self_approval_prohibited": {
      "type": "boolean",
      "const": true
    },
    "approval_bypass_prohibited": {
      "type": "boolean",
      "const": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/approvalRule"
      }
    }
  },
  "$defs": {
    "ruleId": {
      "type": "string",
      "pattern": "^HAR-[0-9]{3}$"
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
    },
    "approvalRole": {
      "type": "string",
      "enum": [
        "AI_GOVERNANCE_LEAD",
        "AIMS_OWNER",
        "INDEPENDENT_REVIEWER",
        "EVIDENCE_OWNER"
      ]
    },
    "approvalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "action",
        "approval_required",
        "minimum_approvals",
        "allowed_approval_roles",
        "reason_required",
        "evidence_reference_required",
        "automated_approval_allowed"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/ruleId"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "approval_required": {
          "type": "boolean",
          "const": true
        },
        "minimum_approvals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "allowed_approval_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/approvalRole"
          }
        },
        "reason_required": {
          "type": "boolean",
          "const": true
        },
        "evidence_reference_required": {
          "type": "boolean"
        },
        "automated_approval_allowed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
