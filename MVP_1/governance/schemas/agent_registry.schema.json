{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urielle-ai.com/schemas/governance/agent_registry.schema.json",
  "title": "Urielle-AI Governance Agent Registry",
  "description": "Configuration contract for components permitted to participate in the Clause 04 deterministic governance pilot. Registration does not grant permission; permissions are evaluated separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "default_execution_mode",
    "components"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "default_execution_mode": {
      "type": "string",
      "const": "DETERMINISTIC_ONLY"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_type",
        "version",
        "enabled",
        "execution_mode",
        "implementation",
        "allowed_actions",
        "prohibited_actions",
        "human_approval_required"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "component_type": {
          "type": "string",
          "enum": [
            "DETERMINISTIC_VALIDATOR",
            "CONFIGURATION_LOADER",
            "POLICY_ENFORCER",
            "AUDIT_LOGGER"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "execution_mode": {
          "type": "string",
          "const": "DETERMINISTIC_ONLY"
        },
        "implementation": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$",
          "minLength": 3,
          "maxLength": 250
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
          }
        },
        "human_approval_required": {
          "type": "boolean"
        }
      }
    }
  }
}
